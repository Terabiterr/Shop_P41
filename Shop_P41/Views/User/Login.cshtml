@using Shop_P41.Models
@model ModelLogin
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "User Login";
    Layout = "_Layout";
}

<form class="form-control" asp-action="login" asp-controller="User" method="post">
    <label asp-for="Email">E-mail: </label>
    <input class="form-control" name="Email" asp-for="Email" type="email" placeholder="email" />
    <label asp-for="Password">Password: </label>
    <input class="form-control" name="Password" asp-for="Password" type="password" placeholder="password" />
    <button class="btn btn-success" type="submit">Login</button>
</form>
