@model ProductImage
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Product Add Image";
    Layout = "_Layout";
}

<form class="form-control" asp-action="Image" asp-controller="Product" method="post">
    <input type="hidden" asp-for="Id" value="0" />
    <label asp-for="ImageUrl">Image Url</label>
    <input class="form-control" asp-for="ImageUrl" type="text" placeholder="ImageUrl" />
    <label asp-for="ProductId">ProductId</label>
    <input class="form-control" asp-for="ProductId" type="text" placeholder="ProductId" />
    <button class="btn btn-success" type="submit">AddImage</button>
</form>