@model IEnumerable<ProductImage>

@{
    ViewData["Title"] = "ProductImage List";
    Layout = "_Layout";
}
<a class="btn btn-success" href="@Url.Action("Index", "Product")">Main Products</a>
@if (!User.Identity.IsAuthenticated)
{
    <a class="btn btn-danger" href="@Url.Action("Register", "User")">Ragister</a>
    <a class="btn btn-primary" href="@Url.Action("Login", "User")">Login</a>
}
else
{
    <a class="btn btn-success" href="@Url.Action("Insert", "Image")">Insert Image</a>
}

@foreach(var image in Model)
{
    <p>@image.ImageUrl</p>
    <p>@image.ProductId</p>
}