@model ProductImage
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "ProductImage INSERT";
    Layout = "_Layout";
}

<form class="form-control" asp-action="Insert" asp-controller="Image" method="post">
    <label asp-for="ImageUrl">ImageUrl</label>
    <input class="form-control" asp-for="ImageUrl" type="text" placeholder="ImageUrl" />
    <label asp-for="ProductId">ProductId</label>
    <input class="form-control" asp-for="ProductId" type="text" placeholder="ProductId" />
    <button class="btn btn-success" type="submit">Insert</button>
</form>